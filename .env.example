# Bind locally only. Do not put API keys in this file when sharing the project.
AI_VIDEO_STUDIO_HOST=127.0.0.1
AI_VIDEO_STUDIO_PORT=4317
# AI_VIDEO_STUDIO_RUNTIME_ROOT=C:\path\to\private\runtime

# Pin the local Codex text model so approved projects do not silently change behavior.
AI_VIDEO_STUDIO_CODEX_MODEL=gpt-5.6-sol
# Windows 默认启用 Codex 的托管代理与系统代理支持；仅在明确不需要系统代理时设为 false。
AI_VIDEO_STUDIO_CODEX_SYSTEM_PROXY=true
# 连续性审核默认使用 medium，避免继承全局 max 后产生超长无输出推理。
AI_VIDEO_STUDIO_CODEX_CONTINUITY_REASONING_EFFORT=medium

# Optional Codex limits. Values are milliseconds; accepted range is 60000–3600000.
# AI_VIDEO_STUDIO_CODEX_TIMEOUT_MS=600000
# AI_VIDEO_STUDIO_ASSET_REFERENCE_PROMPT_TIMEOUT_MS=360000
# AI_VIDEO_STUDIO_CONTINUITY_TIMEOUT_MS=240000
# 图像生成 Provider 为预留接口；未显式配置前保持关闭，不会产生图片 API 费用。
# AI_VIDEO_STUDIO_ASSET_BIBLE_TIMEOUT_MS=720000
