{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "physicalPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "applicability", "entities", "cameraSegments", "subjectOrientations", "displayRelations", "reflectionRelations", "timedStateGates", "feasibilityNotes"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "shot-physical-plan-v1" },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["displaySurfaces", "reflectiveSurfaces", "delayedStateChanges"],
          "properties": {
            "displaySurfaces": { "type": "boolean" },
            "reflectiveSurfaces": { "type": "boolean" },
            "delayedStateChanges": { "type": "boolean" }
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instanceId", "assetId", "domain", "role"],
            "properties": {
              "instanceId": { "type": "string", "minLength": 1 },
              "assetId": { "type": ["string", "null"] },
              "domain": { "type": "string", "enum": ["real-space", "screen-space", "reflection-only"] },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cameraSegments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startOffsetSec", "endOffsetSec", "viewpoint", "screenDirection"],
            "properties": {
              "startOffsetSec": { "type": "number", "minimum": 0 },
              "endOffsetSec": { "type": "number", "exclusiveMinimum": 0 },
              "viewpoint": { "type": "string", "enum": ["front", "rear", "profile", "over-shoulder", "point-of-view", "insert", "reflection-view", "other"] },
              "screenDirection": { "type": "string", "minLength": 1 }
            }
          }
        },
        "subjectOrientations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startOffsetSec", "endOffsetSec", "instanceId", "bodyFaces", "headFaces", "gazeTarget"],
            "properties": {
              "startOffsetSec": { "type": "number", "minimum": 0 },
              "endOffsetSec": { "type": "number", "exclusiveMinimum": 0 },
              "instanceId": { "type": "string", "minLength": 1 },
              "bodyFaces": { "type": "string", "minLength": 1 },
              "headFaces": { "type": "string", "minLength": 1 },
              "gazeTarget": { "type": "string", "minLength": 1 }
            }
          }
        },
        "displayRelations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startOffsetSec", "endOffsetSec", "propId", "holderInstanceId", "surfaceType", "interactionMode", "displayFaces", "visibleToInstanceIds", "cameraReadable", "readabilityMethod"],
            "properties": {
              "startOffsetSec": { "type": "number", "minimum": 0 },
              "endOffsetSec": { "type": "number", "exclusiveMinimum": 0 },
              "propId": { "type": "string", "minLength": 1 },
              "holderInstanceId": { "type": ["string", "null"] },
              "surfaceType": { "type": "string", "enum": ["single-sided", "dual-sided", "unknown"] },
              "interactionMode": { "type": "string", "enum": ["user-reading", "presenting-to-camera", "not-in-use", "other"] },
              "displayFaces": { "type": "string", "enum": ["holder", "camera", "other-subject", "away"] },
              "visibleToInstanceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "cameraReadable": { "type": "boolean" },
              "readabilityMethod": { "type": "string", "enum": ["not-required", "over-shoulder", "side-angle", "insert", "reflection", "intentional-presentation", "other"] }
            }
          }
        },
        "reflectionRelations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surfaceId", "normalReflectionPairs", "mirrorOnlyInstanceIds", "realSpaceInstanceIds", "boundaryVisibleInFrame"],
            "properties": {
              "surfaceId": { "type": "string", "minLength": 1 },
              "normalReflectionPairs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["realInstanceId", "reflectionInstanceId"],
                  "properties": {
                    "realInstanceId": { "type": "string", "minLength": 1 },
                    "reflectionInstanceId": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "mirrorOnlyInstanceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "realSpaceInstanceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "boundaryVisibleInFrame": { "type": "boolean" }
            }
          }
        },
        "timedStateGates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stateId", "startsAtOffsetSec", "beforeState", "afterState", "noEarlyOccurrence"],
            "properties": {
              "stateId": { "type": "string", "minLength": 1 },
              "startsAtOffsetSec": { "type": "number", "minimum": 0 },
              "beforeState": { "type": "string", "minLength": 1 },
              "afterState": { "type": "string", "minLength": 1 },
              "noEarlyOccurrence": { "type": "boolean" }
            }
          }
        },
        "feasibilityNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "required": ["schemaVersion", "targetDurationSec", "shots", "validationNotes"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "shooting-script-v2" },
    "targetDurationSec": { "type": "number", "exclusiveMinimum": 0 },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "projectId", "sequence", "startTimeSec", "endTimeSec", "durationSec", "purpose", "characterIds", "sceneId", "propIds", "styleIds", "shotSize", "camera", "action", "dialogue", "sound", "startState", "endState", "physicalPlan", "preferredProvider", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{3}$" },
          "projectId": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer", "minimum": 1 },
          "startTimeSec": { "type": "integer", "minimum": 0 },
          "endTimeSec": { "type": "integer", "minimum": 1 },
          "durationSec": { "type": "integer", "minimum": 5, "maximum": 15 },
          "purpose": { "type": "string", "minLength": 1 },
          "characterIds": { "type": "array", "items": { "type": "string" } },
          "sceneId": { "type": "string", "minLength": 1 },
          "propIds": { "type": "array", "items": { "type": "string" } },
          "styleIds": { "type": "array", "items": { "type": "string" } },
          "shotSize": { "type": "string", "minLength": 1 },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "movement", "lens", "composition"],
            "properties": {
              "position": { "type": "string", "minLength": 1 },
              "movement": { "type": "string", "minLength": 1 },
              "lens": { "type": ["string", "null"] },
              "composition": { "type": ["string", "null"] }
            }
          },
          "action": { "type": "string", "minLength": 1 },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["speakerId", "text", "language"],
              "properties": {
                "speakerId": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "language": { "type": "string", "minLength": 1 }
              }
            }
          },
          "sound": { "type": "array", "items": { "type": "string" } },
          "startState": { "type": "string", "minLength": 1 },
          "endState": { "type": "string", "minLength": 1 },
          "physicalPlan": { "$ref": "#/$defs/physicalPlan" },
          "preferredProvider": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["draft", "review", "approved", "stale", "generating", "generated", "accepted", "rejected"] }
        }
      }
    },
    "validationNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message", "affectedIds"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "affectedIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
