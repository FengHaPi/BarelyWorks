{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["targetDurationSec", "shots", "validationNotes"],
  "properties": {
    "targetDurationSec": { "type": "number", "exclusiveMinimum": 0 },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "projectId", "sequence", "startTimeSec", "endTimeSec", "durationSec", "purpose", "characterIds", "sceneId", "propIds", "styleIds", "shotSize", "camera", "action", "dialogue", "sound", "startState", "endState", "preferredProvider", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{3}$" },
          "projectId": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer", "minimum": 1 },
          "startTimeSec": { "type": "number", "minimum": 0 },
          "endTimeSec": { "type": "number", "exclusiveMinimum": 0 },
          "durationSec": { "type": "number", "exclusiveMinimum": 0 },
          "purpose": { "type": "string", "minLength": 1 },
          "characterIds": { "type": "array", "items": { "type": "string" } },
          "sceneId": { "type": "string", "minLength": 1 },
          "propIds": { "type": "array", "items": { "type": "string" } },
          "styleIds": { "type": "array", "items": { "type": "string" } },
          "shotSize": { "type": "string", "minLength": 1 },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "movement", "lens", "composition"],
            "properties": {
              "position": { "type": "string", "minLength": 1 },
              "movement": { "type": "string", "minLength": 1 },
              "lens": { "type": ["string", "null"] },
              "composition": { "type": ["string", "null"] }
            }
          },
          "action": { "type": "string", "minLength": 1 },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["speakerId", "text", "language"],
              "properties": {
                "speakerId": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "language": { "type": "string", "minLength": 1 }
              }
            }
          },
          "sound": { "type": "array", "items": { "type": "string" } },
          "startState": { "type": "string", "minLength": 1 },
          "endState": { "type": "string", "minLength": 1 },
          "preferredProvider": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["draft", "review", "approved", "stale", "generating", "generated", "accepted", "rejected"] }
        }
      }
    },
    "validationNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message", "affectedIds"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "affectedIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
