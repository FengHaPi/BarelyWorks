{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contentMarkdown", "changeSummary"],
  "properties": {
    "contentMarkdown": { "type": "string", "minLength": 1 },
    "changeSummary": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
