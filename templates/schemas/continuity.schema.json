{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkedShotIds", "issues", "passed", "uncheckedClaims"],
  "properties": {
    "checkedShotIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message", "affectedIds", "suggestedFix", "requiresReapproval"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "affectedIds": { "type": "array", "items": { "type": "string" } },
          "suggestedFix": { "type": "string", "minLength": 1 },
          "requiresReapproval": { "type": "boolean" }
        }
      }
    },
    "passed": { "type": "boolean" },
    "uncheckedClaims": { "type": "array", "items": { "type": "string" } }
  }
}
